.DS_Store
data/
target/
logs/
.venv/

__pycache__/

# Secrets. The repo is public and `git add .` stages whatever is not named here.
# The same names are kept away from agents by .claude/settings.json and .claude/hooks/block-secrets.sh.
# Checked by tests/test_gitignore_secrets.py.
.env
# Variants of the dotenv file, such as .env.local.
.env.*
# Private keys: .p8 is the form Snowflake's key-pair login uses, .pem is the other common form.
*.p8
*.pem
# The Snowflake command-line tool's config folder, in case it is ever copied into the repo.
.snowflake/
# dbt's credentials file, in case it is ever copied in from ~/.dbt/.
profiles.yml
# The one exception: a placeholder profile with no credentials, which the Stop hook needs to run `dbt parse` offline.
!.claude/hooks/offline-profile/profiles.yml

.ruff_cache/
.codex/

# Leg B3 hand-check drafts: real company names next to lien, license and instrument numbers, links NOT yet verified.
# They stay on this machine until checked. Regenerate with snowflake/19 and snowflake/20.
evals/link_sample_20.csv
evals/draft_test_cases_40.csv
