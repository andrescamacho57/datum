{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.dbt/profiles.yml)",
      "Read(~/.snowflake/**)",
      "Read(**/*.p8)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(~/.dbt/profiles.yml)",
      "Edit(~/.snowflake/**)",
      "Edit(**/*.p8)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(~/.dbt/profiles.yml)",
      "Write(~/.snowflake/**)",
      "Write(**/*.p8)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "[Bb][Aa][Ss][Hh]",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-secrets.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/offline-checks.sh"
          }
        ]
      }
    ]
  }
}
